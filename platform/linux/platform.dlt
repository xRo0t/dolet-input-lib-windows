# ============================================================================
# Linux input adapter
# ============================================================================
# Window owns the selected display-server backend and its event snapshot.
# Input consumes that stable API, so native Wayland and X11 behave identically.

@stack
struct POINT:
    x: i32 = 0
    y: i32 = 0

fun platform_refresh_key_state():
    # Window.poll() already drains and snapshots native events once per frame.
    return

fun platform_get_key_state(key: i32) -> i16:
    if window_key_down(key) == 1:
        return (0 - 32768) as i16
    return 0

fun platform_get_cursor_pos(point: i64) -> i32:
    if point == 0:
        return 0
    Memory.write_i32(point, window_client_mouse_x(Window.handle()))
    Memory.write_i32(point + 4, window_client_mouse_y(Window.handle()))
    return 1
