# Input Module Metadata
# Keyboard and mouse input handling for Dolet

[info]
name = input
version = 1.2.0
description = Portable keyboard, mouse, drag, gamepad, and typed-character input for Dolet with native Windows and X11 adapters

[libs]
# No external libraries needed

[dlls]
# No runtime DLLs to copy

[dependencies]
# No external dependencies

[link.linux]
# The Linux keyboard and pointer adapter queries X11 directly.
flags = -lX11
